# Only needed for `sextant ask`. The viewer uses your Claude Code login and
# needs nothing here.
#
# Copy to .env and fill in. Read by this app from the working directory, and
# never exported to your shell, so no other tool inherits the key. A variable
# set in the environment takes precedence over this file. Nothing but this
# one name is read from it.
#
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
